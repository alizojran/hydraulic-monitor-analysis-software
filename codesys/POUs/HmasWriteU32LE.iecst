// Writes UDINT little-endian.
FUNCTION HmasWriteU32LE : BOOL
VAR_INPUT
    pbyBuf    : POINTER TO BYTE;
    udiOffset : UDINT;
    udiValue  : UDINT;
END_VAR
    pbyBuf[udiOffset] := TO_BYTE(udiValue AND 16#000000FF);
    pbyBuf[udiOffset + 1] := TO_BYTE(SHR(udiValue, 8) AND 16#000000FF);
    pbyBuf[udiOffset + 2] := TO_BYTE(SHR(udiValue, 16) AND 16#000000FF);
    pbyBuf[udiOffset + 3] := TO_BYTE(SHR(udiValue, 24) AND 16#000000FF);
    HmasWriteU32LE := TRUE;
END_FUNCTION
