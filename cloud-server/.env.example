DATABASE_URL=postgres://hmas:hmas_password@127.0.0.1:5432/hmas
TCP_PORT=9100
HTTP_PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Optional bootstrap device. Used by npm run register-device or by server startup.
DEVICE_ID=HMAS-001
DEVICE_SECRET=change-this-device-secret

# Optional safety limits.
TCP_MAX_FRAME_BYTES=1048576
HTTP_HISTORY_LIMIT=2000
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=1000

# Required for /admin and /api/admin/* database management endpoints.
ADMIN_TOKEN=change-this-admin-token
